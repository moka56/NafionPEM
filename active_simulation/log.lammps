# --- PHASE 2: Production Setup ---
# Group water oxygen atoms for specialized tracking
group           water_ox type 6
1200 atoms in group water_ox

# A. Compute MSD (for plot_diffusion.py)
compute         water_diffusion water_ox msd

# B. Compute Channels (for visualization tracking)
compute         channel_count water_ox cluster/atom 3.5

# Assign initial thermal velocities at 300K
velocity        all create 300.0 4928459 mom yes rot yes dist gaussian

# C. Set up NPT Ensemble (Constant Pressure allows box to expand/swell)
# Maintains 300K temperature and 1 atmosphere of pressure
fix             1 all npt temp 300.0 300.0 100.0 iso 1.0 1.0 1000.0

timestep        1.0

# Setup log layout columns
thermo_style    custom step temp epair c_water_diffusion[4] press vol
thermo        5000

# --- PHASE 3: Data File Exports ---

# Export Diffusion MSD Data table
fix             msd_out all print 5000 "$(step) $(c_water_diffusion[4])" file water_msd.dat screen no title "Step Total_MSD"

# Export Swelling Volume Data table
fix             vol_out all print 5000 "$(step) $(vol)" file volume_swelling.dat screen no title "Step Volume"

# Apply an electric field of 0.1 Volts/Angstrom in the X-direction
fix             electric_drive all efield 0.1 0.0 0.0

# 1. Sum up the individual velocities (vx, vy, vz) of your water oxygens
compute         v_sum water_ox reduce sum vx vy vz

# 2. Extract those values into variables (divided by number of atoms to get the average)
variable        num_atoms equal count(water_ox)
variable        avg_vx equal c_v_sum[1]/v_num_atoms
variable        avg_vy equal c_v_sum[2]/v_num_atoms
variable        avg_vz equal c_v_sum[3]/v_num_atoms

# 3. Export these average drift velocities cleanly every 1000 steps
fix             vel_out all print 5000 "$(step) $(v_avg_vx) $(v_avg_vy) $(v_avg_vz)" file water_velocity.dat screen no title "Step Avg_Vx Avg_Vy Avg_Vz"


# Record trajectory frames for Windows OVITO
dump            myDump all custom 10000 trajectory.lammpstrj id mol type q x y z

# Run for 1000000 steps to yield a clean, readable data set
run             1000000
