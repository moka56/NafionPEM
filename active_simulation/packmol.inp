# Packmol input file for Nafion membrane
tolerance 2.0
output membrane_packed.xyz
filetype xyz

structure nafion_chain.xyz
  number 100         # Number of polymer chains
  inside cube 0. 0. 0. 86 # must scale up like number of particles to maintain same density, this is cube side length so if orginally was 50 ( i.e. 
  #volume = 50^3, volume scale up 5x = 50^3*5, then find side length = cube root (50^3*5 =86)))
end structure

structure water.xyz
  number 6000       # Add water to simulate hydration
  inside cube 0. 0. 0. 86
end structure